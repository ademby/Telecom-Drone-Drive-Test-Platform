{
  "name": "drone-drive-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node tools/setup.mjs bootstrap",
    "resume": "node tools/setup.mjs resume",
    "start": "node tools/dev.mjs",
    "dev": "node tools/dev.mjs",
    "dev:frontend": "npm run dev --workspace @drone-drive/frontend",
    "dev:backend": "npm run dev --workspace @drone-drive/backend",
    "dev:backend:debug": "npm run debug --workspace @drone-drive/backend",
    "dev:drone": "npm run dev --workspace @drone-drive/drone-mock",
    "build": "npm run contracts:check && npm run frontend:build && npm run backend:build && npm run drone:build",
    "check": "npm run contracts:check && npm run frontend:check && npm run backend:check && npm run drone:check",
    "contracts:check": "npm run check --workspace @drone-drive/contracts",
    "frontend:build": "npm run build --workspace @drone-drive/frontend",
    "frontend:check": "npm run check --workspace @drone-drive/frontend",
    "backend:build": "npm run build --workspace @drone-drive/backend",
    "backend:check": "npm run check --workspace @drone-drive/backend",
    "db:generate": "npm run generate --workspace @drone-drive/backend",
    "db:migrate": "npm run migrate --workspace @drone-drive/backend",
    "db:up": "node tools/db/podman-db.mjs up",
    "db:down": "node tools/db/podman-db.mjs down",
    "db:reset": "node tools/db/podman-db.mjs reset",
    "db:logs": "node tools/db/podman-db.mjs logs",
    "db:status": "node tools/db/podman-db.mjs status",
    "db:seed-signal-quality": "tsx tools/db/seed-signal-quality.mts",
    "db:seed-demo-missions": "tsx tools/db/seed-demo-missions.mts",
    "drone:build": "npm run build --workspace @drone-drive/drone-mock",
    "drone:check": "npm run check --workspace @drone-drive/drone-mock",
    "platform:check": "npm run check",
    "clean": "node tools/clean.mjs",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.23.1",
    "multer": "2.3.0"
  },
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2"
}
